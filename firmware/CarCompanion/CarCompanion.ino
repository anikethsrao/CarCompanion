double xyz[3];
double X_out, Y_out, Z_out; // Outputs 

bool holdingLeft = 0;
bool holdingRight = 0;
bool speeding = 0;

int sleepSpeed = 75;
int animationSpeed = 10;
int animationCounter = 0;

const float SENSITIVITY = 0.3;
const int ANIMATION_HOLD = 3000;

const int DISLPAY_CENTRE_X = SCREEN_HEIGHT / 2;
const int DISPLAY_CENTRE_Y = SCREEN_HEIGHT / 2;

// *** RECALIBRATE BASED ON ACCELEROMETER LAYOUT ***
// G-Force 

// TURNING
const float TURN_RACING = 0.7;
const float TURN_HARD = 0.5;
const float TURN = 0.3;

// STOPPING 
const float STOP_RACING = 0.7;
const float STOP_HARD = 0.5;
const float STOP = 0.3;

// ACCELERATION 
const float ACC_RACING = 0.5;
const float ACC_HARD = 0.4;
const float ACC = 0.3;

//magnitude of force
float mag;

// Calibration: resting reading captured at startup (gravity + dash tilt)
double X_base = 0, Y_base = 0;
const int CAL_SAMPLES = 50;

// Smoothing: exponential moving average, 0..1 (lower = smoother, slower)
const float SMOOTHING = 0.3;
bool firstReading = true;

void calibrate() {
  double sx = 0, sy = 0;
  for (int i = 0; i < CAL_SAMPLES; i++) {
    adxl.getAcceleration(xyz);
    sx += xyz[0];
    sy += xyz[1];
    delay(10);
  }
  X_base = sx / CAL_SAMPLES;
  Y_base = sy / CAL_SAMPLES;
  Serial.print("Calibrated X base: ");
  Serial.print(X_base);
  Serial.print("  Y base: ");
  Serial.println(Y_base);
}

