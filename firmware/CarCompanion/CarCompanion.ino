void loop() {

  /*
  Wire.beginTransmission(ADXL345);
  Wire.write(0x32); // Start with register 0x32 (ACCEL_XOUT_H)
  Wire.endTransmission(false);
  Wire.requestFrom(ADXL345, 6, true); // Read 6 registers total, each axis value is stored in 2 registers
  X_out = ( Wire.read()| Wire.read() << 8); // X-axis value
  X_out = X_out/256; //For a range of +-2g, we need to divide the raw values by 256, according to the datasheet
  Y_out = ( Wire.read()| Wire.read() << 8); // Y-axis value
  Y_out = Y_out/256;
  Z_out = ( Wire.read()| Wire.read() << 8); // Z-axis value
  Z_out = Z_out/256;
  */

  adxl.getAcceleration(xyz);
  double rawX = xyz[0] - X_base;
  double rawY = xyz[1] - Y_base;
  if (firstReading) {
    X_out = rawX;
    Y_out = rawY;
    firstReading = false;
  } else {
    X_out += SMOOTHING * (rawX - X_out);
    Y_out += SMOOTHING * (rawY - Y_out);
  }
  Z_out = xyz[2];

  mag = sqrt(X_out*X_out + Y_out*Y_out);

  Serial.print("Sensitivity: ");
  Serial.print(SENSITIVITY);
  Serial.print("         ");

  Serial.print("X Acceleration: ");
  Serial.print(X_out);
  Serial.print("         ");

  Serial.print("Y Acceleration: ");
  Serial.print(Y_out);
  Serial.print("         ");

  Serial.print("Z Acceleration: ");
  Serial.print(Z_out);
  Serial.println("         ");
  

  // ACCELERATIONG 
  if (X_out < -SENSITIVITY) {
    Serial.println("Acceleration");
    // RACING ACCELERATION
    if (mag > ACC_RACING) {
      if (!speeding){
        speeding = 1;
        // acceleration(1); // acceleration 1 for racing 
      }
      // holdingSpeeding();
    } 
    // HARD ACCELERATION
    else if (mag > ACC_HARD) {
      //acceleration(2); acceleration 2 for hard acceleration
    }
    // STANDARD ACCELERATION ??? 
    acceleration(3);

  }

  // STOPPING
  else if (X_out > SENSITIVITY){
    Serial.println("Stopping");
    /*
    // RACING STOP
    if (mag > STOP_RACING){
      // comingToAStop(1); // stop 1 for racing stop
    }
    // HARD STOP
    else if (mag > STOP_HARD){
      // comingToAStop(2); // stop 2 for hard stop
    }
    // REGULAR STOP
    else if (mag > STOP){
      // comingToAStop(3); // stop 3 for regular stop
    }
    */
    comingToAStop(2);
  }

  // TURNING RIGHT
  else if (Y_out > SENSITIVITY){
    Serial.println("Right Turn");
    // RACING
    if (mag > TURN_RACING){
      if (!holdingRight) {
        holdingRight = 1;
        animatedRightSlide(1); // 1 for racing
      }
      holdingRightTurn();
    }
    // HARD
    else if (mag > TURN_HARD){
      animatedRightSlide(2); // 2 for hard 
      // holdingRightTurn();
    }
    // STANDARD 
    else if (mag > TURN){
      animatedRightSlide(3); // 3 for standard 
    }
  }

  // TURNING LEFT
  else if (Y_out < -SENSITIVITY){
    Serial.println("Left Turn");
    // RACING
    if (mag > TURN_RACING){
      Serial.println("Left Turn");
      if (!holdingLeft){
        holdingLeft = 1;
        animatedLeftSlide(1); // 1 for racing
      }
      holdingLeftTurn();
    }
    // HARD
    else if (mag > TURN_HARD){
      animatedLeftSlide(2); // 2 for hard 
      // holdingLeftTurn();
    }
    // STANDARD 
    else if (mag > TURN){
      animatedLeftSlide(3); // 3 for standard 
    }
  }

  // STANARD FACE 
  else {
    display.clearDisplay();
    display.drawBitmap(0,0, littleSmile, 128, 64, WHITE);
    display.display();
    delay(200);

    if (holdingLeft == 1 || holdingRight == 1 || speeding == 1){
      /*
      if (animationCounter < ANIMATION_HOLD) {
        display.clearDisplay();
        display.drawBitmap(66/2,0, shocked, 67, 64, WHITE);
        display.display();
        animationCounter += 1;
      }
      */
      holdingLeft = 0;
      holdingRight = 0;
      speeding = 0;
    }
  }

}

